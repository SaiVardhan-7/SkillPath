PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/skillpath
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
NODE_ENV=development
# Comma-separated list of allowed web origins in production (e.g. https://saivardhan-7.github.io). Leave empty to allow all.
CORS_ORIGIN=
